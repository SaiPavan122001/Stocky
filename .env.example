# Copy to .env and adjust as needed for local development.
# docker-compose.yml reads these to configure the three services.

# --- Postgres ---
POSTGRES_USER=stocky
POSTGRES_PASSWORD=stocky
POSTGRES_DB=stocky
POSTGRES_PORT=5432

# --- backend-go (core API) ---
DATABASE_URL=postgres://stocky:stocky@postgres:5432/stocky?sslmode=disable
JWT_SECRET=dev-secret-change-me
PRICE_SERVICE_URL=http://backend-price:5000
GO_API_PORT=8080

# --- backend-price (Flask price service) ---
PRICE_SERVICE_PORT=5000
