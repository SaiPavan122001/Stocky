# Copy to .env in each service directory (or export these) as needed for
# local development. Services run as native processes (no Docker) for now;
# SQLite needs no separate database server.

# --- backend-go (core API) ---
DATABASE_PATH=stocky.db
JWT_SECRET=dev-secret-change-me
PORT=8080
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081,http://10.0.2.2:5173
PRICE_SERVICE_URL=http://localhost:5000

# --- backend-price (Flask price service) ---
PRICE_SERVICE_PORT=5000
